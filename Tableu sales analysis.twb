            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1ivdyq002r491u1684zgu0cwh6la].[sum:Profit:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1ivdyq002r491u1684zgu0cwh6la].[sum:Sales:qk]&quot;' />
